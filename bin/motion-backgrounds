#!/bin/bash

set -euo pipefail

readonly PLUGIN_ID="io.github.pulkitchauhan.motion-backgrounds"
readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly PLUGIN_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
readonly CONFIG_DIR="$CONFIG_HOME/motion-backgrounds"
readonly WALLS_DIR="$CONFIG_DIR/walls"
readonly USER_BIN_DIR="$HOME/.local/bin"
readonly CLI_PATH="$USER_BIN_DIR/motion-backgrounds"
readonly CONTROLLER_PATH="$PLUGIN_DIR/bin/motion-backgrounds"
readonly STATE_DIR="$STATE_HOME/motion-backgrounds"
readonly STATE_FILE="$STATE_DIR/current.json"
readonly INITIALIZED_FILE="$STATE_DIR/initialized"
readonly DEFAULT_PENDING_FILE="$STATE_DIR/activate-default-pending"
readonly DEFAULT_REMOVED_FILE="$STATE_DIR/default-removed"
readonly CACHE_DIR="$CACHE_HOME/motion-backgrounds/thumbnails"
readonly CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme/backgrounds"
readonly CURRENT_THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
readonly CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"
readonly MENU_FILE="$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
readonly MENU_ENTRY="$PLUGIN_DIR/assets/menu-entry.jsonc"
readonly DEFAULT_WALLPAPER_NAME="Katana.mp4"
readonly LEGACY_DEFAULT_WALLPAPER_NAME="samurai-katana-in-forest-cinematic-4k-live-wallpaper.mp4"
readonly BUNDLED_WALLS_DIR="$PLUGIN_DIR/assets/walls"
readonly BUNDLED_WALLPAPER="$BUNDLED_WALLS_DIR/$DEFAULT_WALLPAPER_NAME"
readonly BUNDLED_WALLPAPERS_INSTALLED_FILE="$STATE_DIR/bundled-wallpapers-v2-installed"
readonly FALLBACK_THUMBNAIL="$PLUGIN_DIR/assets/video.svg"
readonly BACKGROUND_TRANSITION_SECONDS="0.46"

usage() {
  cat <<'USAGE'
Usage: motion-backgrounds <command> [argument]

Commands:
  bootstrap        Initialize user data and Omarchy menu integration
  cleanup          Remove integration, state, and cache (keeps wallpapers)
  pick             Open the mixed image/video wallpaper picker
  add <file>       Copy a wallpaper into the global library and activate it
  remove <file>    Move a global wallpaper to the trash
  apply <file>     Apply a path or a filename from the global library
  reconcile        Restore or reconcile the saved live wallpaper
  stop             Stop the live wallpaper and clear its saved state
  list             List removable wallpapers in the global library
  list-rows        Print machine-readable picker rows
  status           Print the active live wallpaper, if any
USAGE
}

notify_error() {
  local message="$1"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "Motion Backgrounds" "$message" -t 4000 >/dev/null 2>&1 || true
  fi
  printf 'motion-backgrounds: %s\n' "$message" >&2
}

lower_extension() {
  local name="${1##*.}"
  printf '%s' "${name,,}"
}

is_video() {
  case "$(lower_extension "$1")" in
    mp4|webm|mkv|mov|m4v) return 0 ;;
    *) return 1 ;;
  esac
}

is_image() {
  case "$(lower_extension "$1")" in
    jpg|jpeg|png|webp|gif|bmp) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_dirs() {
  mkdir -p "$WALLS_DIR" "$STATE_DIR" "$CACHE_DIR"
}

strip_menu_entry() {
  local source="$1"
  local destination="$2"

  awk '
    /^[[:space:]]*\/\/ motion-backgrounds:start[[:space:]]*$/ { skipping = 1; next }
    /^[[:space:]]*\/\/ motion-backgrounds:end[[:space:]]*$/ { skipping = 0; next }
    !skipping { print }
  ' "$source" >"$destination"
}

install_default_wallpaper() {
  local destination="$WALLS_DIR/$DEFAULT_WALLPAPER_NAME"
  local legacy_destination="$WALLS_DIR/$LEGACY_DEFAULT_WALLPAPER_NAME"
  local saved_path scope theme

  [[ ! -e $DEFAULT_REMOVED_FILE ]] || return 0

  [[ -f $BUNDLED_WALLPAPER ]] || {
    notify_error "Bundled wallpaper is missing"
    return 1
  }

  if [[ ! -e $destination ]]; then
    if [[ -f $legacy_destination ]]; then
      mv -- "$legacy_destination" "$destination"
    else
      install -m 0644 "$BUNDLED_WALLPAPER" "$destination"
    fi
  fi

  if [[ -s $STATE_FILE ]]; then
    saved_path=$(state_value path)
    if [[ $saved_path == "$legacy_destination" ]]; then
      scope=$(state_value scope)
      theme=$(state_value theme)
      write_state "$destination" "${scope:-global}" "$theme"
      stop_player
    fi
  fi
}

install_bundled_wallpapers() {
  local source destination name

  # Install the expanded bundled library once. This gives existing users the
  # new collection on update, while ensuring a wallpaper deliberately removed
  # later is never silently restored by a subsequent bootstrap.
  [[ -e $BUNDLED_WALLPAPERS_INSTALLED_FILE ]] && return 0

  [[ -d $BUNDLED_WALLS_DIR ]] || {
    notify_error "Bundled wallpaper directory is missing"
    return 1
  }

  while IFS= read -r -d '' source; do
    name=$(basename "$source")
    [[ $name == "$DEFAULT_WALLPAPER_NAME" ]] && continue
    destination="$WALLS_DIR/$name"
    [[ -e $destination ]] || install -m 0644 "$source" "$destination"
  done < <(
    find "$BUNDLED_WALLS_DIR" -maxdepth 1 -type f \
      \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \
         -o -iname '*.mov' -o -iname '*.m4v' \) -print0 | sort -z
  )

  : >"$BUNDLED_WALLPAPERS_INSTALLED_FILE"
}

install_menu_entry() {
  local clean_file temporary

  [[ -f $MENU_ENTRY ]] || {
    notify_error "Bundled menu entry is missing"
    return 1
  }

  mkdir -p "$(dirname "$MENU_FILE")"
  if [[ ! -f $MENU_FILE ]]; then
    printf '{\n}\n' >"$MENU_FILE"
  fi

  clean_file="$MENU_FILE.clean.$$"
  temporary="$MENU_FILE.tmp.$$"
  strip_menu_entry "$MENU_FILE" "$clean_file"

  awk -v block="$MENU_ENTRY" '
    !inserted && index($0, "{") {
      print
      while ((getline line < block) > 0) print line
      close(block)
      inserted = 1
      next
    }
    { print }
    END { if (!inserted) exit 1 }
  ' "$clean_file" >"$temporary"

  rm -f "$clean_file"
  mv -f "$temporary" "$MENU_FILE"
  omarchy menu refresh >/dev/null 2>&1 || true
}

remove_menu_entry() {
  local temporary

  [[ -f $MENU_FILE ]] || return 0
  temporary="$MENU_FILE.tmp.$$"
  strip_menu_entry "$MENU_FILE" "$temporary"
  mv -f "$temporary" "$MENU_FILE"
  omarchy menu refresh >/dev/null 2>&1 || true
}

install_cli() {
  mkdir -p "$USER_BIN_DIR"

  if [[ -e $CLI_PATH || -L $CLI_PATH ]]; then
    if [[ -L $CLI_PATH && $(readlink -f "$CLI_PATH" 2>/dev/null || true) == "$CONTROLLER_PATH" ]]; then
      return 0
    fi

    notify_error "Command already exists and was left unchanged: $CLI_PATH"
    return 0
  fi

  ln -s "$CONTROLLER_PATH" "$CLI_PATH"
}

remove_cli() {
  if [[ -L $CLI_PATH && $(readlink -f "$CLI_PATH" 2>/dev/null || true) == "$CONTROLLER_PATH" ]]; then
    rm -f "$CLI_PATH"
  fi
}

check_dependencies() {
  local qml_dir="/usr/lib/qt6/qml"
  local plugins_dir="/usr/lib/qt6/plugins"

  if command -v qmake6 >/dev/null 2>&1; then
    qml_dir=$(qmake6 -query QT_INSTALL_QML 2>/dev/null || printf '%s' "$qml_dir")
    plugins_dir=$(qmake6 -query QT_INSTALL_PLUGINS 2>/dev/null || printf '%s' "$plugins_dir")
  fi

  [[ -f $qml_dir/QtMultimedia/qmldir ]] || {
    notify_error "Install the official Qt video backend: omarchy pkg add qt6-multimedia-ffmpeg"
    return 1
  }

  [[ -f $plugins_dir/multimedia/libffmpegmediaplugin.so ]] || {
    notify_error "Install the official Qt FFmpeg backend: omarchy pkg add qt6-multimedia-ffmpeg"
    return 1
  }

  command -v ffmpeg >/dev/null 2>&1 || {
    notify_error "Install the official video tools: omarchy pkg add ffmpeg"
    return 1
  }
}

bootstrap() {
  local default_wallpaper="$WALLS_DIR/$DEFAULT_WALLPAPER_NAME"

  ensure_dirs

  # Only queue automatic activation when bootstrap is installing Katana for
  # the first time. Existing installations may intentionally have no live
  # state because the user selected a static wallpaper.
  if [[ ! -e $INITIALIZED_FILE && ! -e $DEFAULT_PENDING_FILE && ! -e $default_wallpaper ]]; then
    : >"$DEFAULT_PENDING_FILE"
  fi

  install_default_wallpaper
  install_bundled_wallpapers
  install_menu_entry
  install_cli

  if [[ -e $DEFAULT_PENDING_FILE ]]; then
    # Keep the pending marker when Qt Multimedia is unavailable. A later bootstrap
    # will finish first-run activation after the dependency is installed.
    if check_dependencies; then
      set_live "$default_wallpaper" || true
    fi
  else
    mark_initialized
    check_dependencies || true
  fi
}

cleanup() {
  stop_player
  remove_menu_entry
  remove_cli
  rm -rf "$STATE_DIR" "$CACHE_HOME/motion-backgrounds"
}

stop_player() {
  omarchy-shell -q motion-backgrounds stopPlayback >/dev/null 2>&1 || true
}

clear_state() {
  rm -f "$STATE_FILE"
}

mark_initialized() {
  rm -f "$DEFAULT_PENDING_FILE"
  : >"$INITIALIZED_FILE"
}

active_theme_name() {
  if [[ -f $CURRENT_THEME_NAME_FILE ]]; then
    tr -d '\n' <"$CURRENT_THEME_NAME_FILE"
  fi
}

wallpaper_scope() {
  local path="$1"
  case "$path" in
    "$WALLS_DIR"/*) printf 'global' ;;
    *) printf 'theme' ;;
  esac
}

write_state() {
  local path="$1"
  local scope="$2"
  local theme="$3"
  local temporary="$STATE_FILE.tmp.$$"

  jq -n \
    --arg path "$path" \
    --arg scope "$scope" \
    --arg theme "$theme" \
    '{path: $path, scope: $scope, theme: $theme}' >"$temporary"
  mv -f "$temporary" "$STATE_FILE"
}

start_player() {
  local path="$1"

  check_dependencies || return 1
  if ! omarchy-shell motion-backgrounds play "$path" >/dev/null 2>&1; then
    notify_error "Omarchy Shell is not running; restart it and try again"
    return 1
  fi
}

active_live_path() {
  [[ -s $STATE_FILE ]] || return 0

  local path
  path=$(state_value path)
  if [[ -n $path && -f $path ]] && is_video "$path"; then
    printf '%s' "$path"
  fi
}

prepare_live_handoff() {
  local path poster

  path=$(active_live_path)
  if [[ -n $path ]]; then
    poster=$(thumbnail_for_video "$path")
    if [[ -n $poster && -f $poster ]]; then
      # Prime Omarchy's background beneath the video surface before removing
      # it. This keeps video-to-video and video-to-image transitions from
      # briefly exposing an unrelated older wallpaper.
      omarchy-shell -q background setInstant "$poster" >/dev/null 2>&1 || true
    fi
  fi

  stop_player
}

set_animated_backdrop() {
  local path="$1"

  omarchy-theme-bg-set "$path"
  sleep "$BACKGROUND_TRANSITION_SECONDS"
}

set_live() {
  local input="$1"
  local path scope theme poster current

  path=$(realpath "$input" 2>/dev/null || true)
  [[ -f $path ]] || {
    notify_error "Wallpaper does not exist: $input"
    return 1
  }

  scope=$(wallpaper_scope "$path")
  theme=""
  if [[ $scope == theme ]]; then
    theme=$(active_theme_name)
  fi

  current=$(active_live_path)
  if [[ $current == "$path" ]]; then
    start_player "$path"
    return 0
  fi

  poster=$(thumbnail_for_video "$path")
  [[ -n $poster && -f $poster ]] || {
    notify_error "Could not create a preview for: $path"
    return 1
  }

  prepare_live_handoff
  set_animated_backdrop "$poster"
  write_state "$path" "$scope" "$theme"
  start_player "$path"
  mark_initialized
}

set_static() {
  local input="$1"
  local path

  path=$(realpath "$input" 2>/dev/null || true)
  [[ -f $path ]] || {
    notify_error "Wallpaper does not exist: $input"
    return 1
  }

  prepare_live_handoff
  clear_state
  omarchy-theme-bg-set "$path"
  mark_initialized
}

apply_wallpaper() {
  local input="${1:-}"
  local path

  [[ -n $input ]] || {
    notify_error "No wallpaper was selected"
    return 2
  }

  if [[ -f $input ]]; then
    path=$(realpath "$input" 2>/dev/null || true)
  elif [[ -f $WALLS_DIR/$input ]]; then
    path=$(realpath "$WALLS_DIR/$input" 2>/dev/null || true)
  else
    notify_error "Wallpaper does not exist: $input"
    return 1
  fi

  if is_video "$path"; then
    set_live "$path"
  elif is_image "$path"; then
    set_static "$path"
  else
    notify_error "Unsupported wallpaper type: $path"
    return 2
  fi
}

add_wallpaper() {
  local input="${1:-}"
  local source destination

  [[ -n $input ]] || {
    notify_error "No wallpaper was provided"
    return 2
  }

  source=$(realpath "$input" 2>/dev/null || true)
  [[ -f $source ]] || {
    notify_error "Wallpaper does not exist: $input"
    return 1
  }

  if ! is_video "$source" && ! is_image "$source"; then
    notify_error "Unsupported wallpaper type: $source"
    return 2
  fi

  ensure_dirs
  destination="$WALLS_DIR/$(basename "$source")"

  if [[ $source != "$destination" ]]; then
    if [[ -e $destination ]]; then
      if ! cmp -s -- "$source" "$destination"; then
        notify_error "A different wallpaper with that name already exists: $destination"
        return 1
      fi
    else
      install -m 0644 "$source" "$destination"
    fi
  fi

  if [[ $destination == "$WALLS_DIR/$DEFAULT_WALLPAPER_NAME" ]]; then
    rm -f "$DEFAULT_REMOVED_FILE"
  fi

  apply_wallpaper "$destination"
}

resolve_library_wallpaper() {
  local input="$1"
  local path

  if [[ -f $input ]]; then
    path=$(realpath "$input" 2>/dev/null || true)
  else
    path=$(realpath "$WALLS_DIR/$input" 2>/dev/null || true)
  fi

  [[ -f $path ]] || return 1
  case "$path" in
    "$WALLS_DIR"/*) printf '%s' "$path" ;;
    *) return 2 ;;
  esac
}

thumbnail_cache_path() {
  local video="$1"
  local signature hash

  signature=$(stat -Lc '%s:%Y' "$video" 2>/dev/null) || return 0
  hash=$(printf '%s\t%s' "$video" "$signature" | md5sum | cut -d ' ' -f 1)
  printf '%s/%s.jpg' "$CACHE_DIR" "$hash"
}

trash_file() {
  gio trash -- "$1"
}

remove_wallpaper() {
  local input="${1:-}"
  local path active current_background cached_thumbnail=""

  [[ -n $input ]] || {
    notify_error "No wallpaper was provided"
    return 2
  }

  path=$(resolve_library_wallpaper "$input") || {
    notify_error "Wallpaper is not in the global library: $input"
    return 1
  }

  active=$(active_live_path)
  current_background=$(readlink -f "$CURRENT_BACKGROUND_LINK" 2>/dev/null || true)

  if [[ $current_background == "$path" && $active != "$path" ]]; then
    notify_error "Select another wallpaper before removing the active static wallpaper"
    return 1
  fi

  if is_video "$path"; then
    cached_thumbnail=$(thumbnail_cache_path "$path")
  fi

  if [[ $active == "$path" ]]; then
    prepare_live_handoff
  fi

  if ! trash_file "$path"; then
    if [[ $active == "$path" ]]; then
      start_player "$path" || true
    fi
    notify_error "Could not move wallpaper to the trash: $path"
    return 1
  fi

  if [[ $active == "$path" ]]; then
    clear_state
    mark_initialized
  fi

  if [[ $path == "$WALLS_DIR/$DEFAULT_WALLPAPER_NAME" ]]; then
    : >"$DEFAULT_REMOVED_FILE"
  fi

  if [[ -n $cached_thumbnail ]]; then
    rm -f "$cached_thumbnail"
  fi

  printf 'Moved to trash: %s\n' "$path"
}

state_value() {
  local key="$1"
  jq -r --arg key "$key" '.[$key] // empty' "$STATE_FILE" 2>/dev/null || true
}

reconcile() {
  ensure_dirs
  [[ -s $STATE_FILE ]] || return 0

  local path scope saved_theme current_theme
  path=$(state_value path)
  scope=$(state_value scope)
  saved_theme=$(state_value theme)

  if [[ -z $path || ! -f $path ]]; then
    stop_player
    clear_state
    return 0
  fi

  if [[ $scope == theme ]]; then
    current_theme=$(active_theme_name)
    if [[ -z $saved_theme || $saved_theme != "$current_theme" ]]; then
      stop_player
      clear_state
      return 0
    fi
  fi

  start_player "$path"
}

thumbnail_for_video() {
  local video="$1"
  local signature hash thumbnail temporary

  signature=$(stat -Lc '%s:%Y' "$video") || return 1
  hash=$(printf '%s\t%s' "$video" "$signature" | md5sum | cut -d ' ' -f 1)
  thumbnail="$CACHE_DIR/$hash.jpg"

  if [[ ! -s $thumbnail ]]; then
    temporary="$thumbnail.tmp.$$.jpg"
    if command -v ffmpeg >/dev/null 2>&1 && ffmpeg -hide_banner -loglevel error -y \
      -ss 1 -i "$video" -frames:v 1 \
      -vf "scale=1536:864:force_original_aspect_ratio=decrease,pad=1536:864:(ow-iw)/2:(oh-ih)/2" \
      "$temporary"; then
      mv -f "$temporary" "$thumbnail"
    else
      rm -f "$temporary"
    fi
  fi

  if [[ -s $thumbnail ]]; then
    printf '%s' "$thumbnail"
  else
    printf '%s' "$FALLBACK_THUMBNAIL"
  fi
}

list_library() {
  ensure_dirs

  find -L "$WALLS_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
       -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
       -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \
       -o -iname '*.mov' -o -iname '*.m4v' \) \
    -printf '%f\n' 2>/dev/null | sort
}

list_rows() {
  ensure_dirs

  local theme_name user_theme_dir directory wallpaper thumbnail
  local -a directories

  theme_name=$(active_theme_name)
  user_theme_dir="$HOME/.config/omarchy/backgrounds/$theme_name"
  directories=("$CURRENT_THEME_DIR" "$user_theme_dir" "$WALLS_DIR")

  for directory in "${directories[@]}"; do
    [[ -d $directory ]] || continue

    while IFS= read -r -d '' wallpaper; do
      if is_video "$wallpaper"; then
        thumbnail=$(thumbnail_for_video "$wallpaper")
      elif is_image "$wallpaper"; then
        thumbnail="$wallpaper"
      else
        continue
      fi

      printf '%s\t%s\n' "$wallpaper" "$thumbnail"
    done < <(
      find -L "$directory" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
           -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \
           -o -iname '*.mov' -o -iname '*.m4v' \) \
        -print0 2>/dev/null | sort -z
    )
  done
}

selected_wallpaper() {
  local saved_path
  if [[ -s $STATE_FILE ]]; then
    saved_path=$(state_value path)
    if [[ -f $saved_path ]]; then
      printf '%s' "$saved_path"
      return 0
    fi
  fi

  readlink -f "$CURRENT_BACKGROUND_LINK" 2>/dev/null || true
}

pick_wallpaper() {
  ensure_dirs
  local rows rows_b64 selected open_result choice
  rows=$(list_rows)
  [[ -n $rows ]] || {
    notify_error "No wallpapers found in the current theme or $WALLS_DIR"
    return 1
  }

  rows_b64=$(printf '%s' "$rows" | base64 -w 0)
  selected=$(selected_wallpaper)
  PICK_SELECTION_FILE=$(mktemp)
  PICK_DONE_FILE=$(mktemp)
  rm -f "$PICK_DONE_FILE"
  trap 'rm -f "${PICK_SELECTION_FILE:-}" "${PICK_DONE_FILE:-}"' EXIT

  open_result=$(omarchy-shell image-selector open \
    "" "$rows_b64" "$selected" "$PICK_SELECTION_FILE" "$PICK_DONE_FILE" true true) || {
      notify_error "Omarchy's image picker did not accept the request"
      return 1
    }

  [[ $open_result == ok ]] || {
    notify_error "Omarchy's image picker returned: $open_result"
    return 1
  }

  while [[ ! -e $PICK_DONE_FILE ]]; do
    sleep 0.02
  done

  if [[ -s $PICK_SELECTION_FILE ]]; then
    choice=$(<"$PICK_SELECTION_FILE")
    apply_wallpaper "$choice"
  fi
}

print_status() {
  [[ -s $STATE_FILE ]] || return 0
  state_value path
}

main() {
  ensure_dirs

  case "${1:-}" in
    bootstrap) bootstrap ;;
    cleanup) cleanup ;;
    pick) pick_wallpaper ;;
    add) add_wallpaper "${2:-}" ;;
    remove|rm) remove_wallpaper "${2:-}" ;;
    apply) apply_wallpaper "${2:-}" ;;
    reconcile|restore) reconcile ;;
    stop) stop_player; clear_state; mark_initialized ;;
    list|ls) list_library ;;
    list-rows) list_rows ;;
    status) print_status ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
